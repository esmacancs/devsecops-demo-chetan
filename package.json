{
  "name": "devsecops-demo",
  "version": "1.0.0",
  "description": "End-to-end DevSecOps demo: Node.js/Express API with CI/CD, SAST, secret detection, dependency scanning, IaC scanning and container scanning.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "audit": "npm audit --audit-level=high",
    "retire": "retire --severity high",
    "licenses": "license-checker --summary",
    "sast": "eslint src tests --format json --output-file gl-sast-report.json",
    "secrets": "gitleaks detect --source . --report-path gl-secret-detection-report.json --no-banner"
  },
  "dependencies": {
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "license-checker": "^25.0.1",
    "retire": "^4.3.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 60,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "jest-junit": {
    "outputDirectory": ".",
    "outputName": "junit.xml"
  },
  "license": "MIT"
}
